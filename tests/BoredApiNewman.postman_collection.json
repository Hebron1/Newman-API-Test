    {
      "name": "GET data by Filter",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const validType = [\r",
              "        \"education\",\r",
              "        \"recreational\",\r",
              "        \"social\",\r",
              "        \"charity\",\r",
              "        \"cooking\",\r",
              "        \"relaxation\",\r",
              "        \"busywork\"\r",
              "    ]\r",
              "// const randomType = validType[4];\r",
              "const randomType = validType[Math.floor(Math.random() * validType.length)];\r",
              "\r",
              "pm.environment.set(\"type\", randomType);\r",
              "\r",
              "pm.environment.get(\"base_url\")\r",
              "pm.environment.get(\"type\")"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/filter?type={{type}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "filter"
          ],
          "query": [
            {
              "key": "type",
              "value": "{{type}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Data by type education",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"the education are kidfriendly\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData[0].kidFriendly).to.eql(true);\r",
              "})\r",
              "\r",
              "pm.test(\"All type include education\", function () {\r",
              "    const validType = \"education\";\r",
              "    const data = pm.response.json();\r",
              "    const types = data.every(item => item.type == validType);\r",
              "\r",
              "    pm.expect(types).to.be.true;\r",
              "})\r",
              "    // pm.expect(validType).to.include(pm.response.json()[0].type);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
