          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"TC001 - response code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"TC002 - Kidfriendly are exist\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.kidFriendly).to.eql(true);\r",
              "})\r",
              "\r",
              "pm.test(\"TC003 - Type of activity must be valid\", () => {\r",
              "    const validType = [\r",
              "        \"education\",\r",
              "        \"recreational\",\r",
              "        \"social\",\r",
              "        \"charity\",\r",
              "        \"cooking\",\r",
              "        \"relaxation\",\r",
              "        \"busywork\"\r",
              "    ]\r",
              "    pm.expect(validType).to.include(pm.response.json().type);\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
