          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"theType\", \"education\");\r",
              "pm.environment.get(\"base_url\")\r",
              "pm.environment.get(\"theType\")"
            ],
            "type": "text/javascript",
